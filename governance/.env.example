# --- Target chain ---
RPC_URL=
CHAIN_ID=

# --- Acting owner ---
# Private key of the Safe owner running this command (proposes / confirms / executes). It must be one
# of the Safe's owners. Never commit a real key; .env is gitignored.
SIGNER_KEY=

# --- Safe Transaction Service ---
# API key for the hosted service (https://developer.safe.global). Required when talking to safe.global.
# For a self-hosted Transaction Service, set SAFE_TX_SERVICE_URL and the key may be optional.
SAFE_API_KEY=
# SAFE_TX_SERVICE_URL=

# --- Safes ---
GOV_SAFE=       # governance Safe (the timelock executor)
GUARDIAN_SAFE=  # guardian Safe (instant freeze only)

# --- Deployment addresses (targets of governance operations) ---
TIMELOCK=
ENGINE=
TOKEN=
MEDIAN=
